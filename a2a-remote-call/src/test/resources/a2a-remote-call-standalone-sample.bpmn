<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:a2a-remote="http://fluxnova.finos.org/schema/1.0/ai/a2a-remote"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Fluxnova Modeler"
                  exporterVersion="1.0.0">

  <bpmn:process id="amlInvestigationProcess" name="AML Investigation Process" isExecutable="true">

    <bpmn:startEvent id="startEvent" name="Transaction Received">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="callAmlAgent" name="Call AML Agent"
                      camunda:type="a2a-remote-call">
      <bpmn:extensionElements>
        <a2a-remote:config url="http://localhost:8085"
                           prompt="${'Investigate transaction ' + transactionId}"
                           name="AML Investigation Agent"
                           description="Investigates AML alerts" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="a2aErrorBoundary" name="A2A Error"
                        attachedToRef="callAmlAgent">
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1"
                                  errorRef="Error_a2aRemoteCallError" />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="handleError" name="Handle A2A Error"
                      camunda:type="external"
                      camunda:topic="HandleA2aErrorWorker">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endEvent" name="Investigation Complete">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="errorEndEvent" name="Error Handled">
      <bpmn:incoming>flow4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow1" sourceRef="startEvent" targetRef="callAmlAgent" />
    <bpmn:sequenceFlow id="flow2" sourceRef="callAmlAgent" targetRef="endEvent" />
    <bpmn:sequenceFlow id="flow3" sourceRef="a2aErrorBoundary" targetRef="handleError" />
    <bpmn:sequenceFlow id="flow4" sourceRef="handleError" targetRef="errorEndEvent" />

  </bpmn:process>

  <bpmn:error id="Error_a2aRemoteCallError" name="A2A Remote Call Error"
              errorCode="a2a-remote-call-error" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="amlInvestigationProcess">
      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="179" y="209" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="callAmlAgent_di" bpmnElement="callAmlAgent">
        <dc:Bounds x="280" y="187" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a2aErrorBoundary_di" bpmnElement="a2aErrorBoundary">
        <dc:Bounds x="312" y="249" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handleError_di" bpmnElement="handleError">
        <dc:Bounds x="380" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_di" bpmnElement="endEvent">
        <dc:Bounds x="452" y="209" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="errorEndEvent_di" bpmnElement="errorEndEvent">
        <dc:Bounds x="552" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="215" y="227" />
        <di:waypoint x="280" y="227" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="380" y="227" />
        <di:waypoint x="452" y="227" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="330" y="285" />
        <di:waypoint x="330" y="370" />
        <di:waypoint x="380" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="480" y="370" />
        <di:waypoint x="552" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
