<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:agent="http://fluxnova.finos.org/schema/1.0/ai/agent"
                  xmlns:a2a-remote="http://fluxnova.finos.org/schema/1.0/ai/a2a-remote"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Fluxnova Modeler"
                  exporterVersion="1.0.0">

  <bpmn:process id="fraudAnalysisProcess" name="Fraud Analysis Process" isExecutable="true">

    <bpmn:startEvent id="startEvent" name="Alert Received">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:adHocSubProcess id="agentScope" name="Fraud Analysis Agent Scope">
      <bpmn:extensionElements>
        <agent:config provider="openai"
                      model="gpt-4"
                      systemPrompt="You are a fraud analysis assistant. Investigate suspicious transactions using available tools and remote agents. Coordinate between AML investigation, fraud detection, and data enrichment to produce a comprehensive risk assessment." />
        <a2a-remote:agents>
          <a2a-remote:agent id="amlAgent"
                            name="AML Investigation Agent"
                            url="http://localhost:8085"
                            description="Investigates AML alerts" />
          <a2a-remote:agent id="fraudAgent"
                            name="Fraud Detection Agent"
                            url="http://fraud-agent:8090"
                            description="Detects fraudulent transactions" />
        </a2a-remote:agents>
      </bpmn:extensionElements>
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>

      <!-- Local BPMN service task tool -->
      <bpmn:serviceTask id="enrichData" name="Enrich Data"
                        camunda:type="external"
                        camunda:topic="EnrichDataWorker">
        <bpmn:documentation>Enriches customer data from CRM</bpmn:documentation>
      </bpmn:serviceTask>

    </bpmn:adHocSubProcess>

    <bpmn:endEvent id="endEvent" name="Analysis Complete">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow1" sourceRef="startEvent" targetRef="agentScope" />
    <bpmn:sequenceFlow id="flow2" sourceRef="agentScope" targetRef="endEvent" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="fraudAnalysisProcess">
      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="179" y="259" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="agentScope_di" bpmnElement="agentScope" isExpanded="true">
        <dc:Bounds x="280" y="160" width="350" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enrichData_di" bpmnElement="enrichData">
        <dc:Bounds x="330" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_di" bpmnElement="endEvent">
        <dc:Bounds x="702" y="259" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="215" y="277" />
        <di:waypoint x="280" y="277" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="630" y="277" />
        <di:waypoint x="702" y="277" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
