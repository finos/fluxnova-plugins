<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
	  <groupId>org.finos.fluxnova.bpm.extension</groupId>
	  <artifactId>fluxnova-keycloak-root</artifactId>
	  <version>1.0.0-SNAPSHOT</version>
	</parent>

    <artifactId>fluxnova-keycloak-all</artifactId>

	<packaging>jar</packaging>
    <name>Fluxnova Platform - engine plugins - identity - keycloak - extension - all</name>
	<description>Fluxnova Keycloak Identity Provider Plugin including all transitive dependencies</description>

	<properties>
		<skip.source.attach>true</skip.source.attach>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.finos.fluxnova.bpm.extension</groupId>
			<artifactId>fluxnova-keycloak</artifactId>
		</dependency>

		<dependency>
		    <groupId>org.springframework</groupId>
		    <artifactId>spring-web</artifactId>
		</dependency>

		<!-- http client 5 -->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
		</dependency>

        <dependency>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- assemble -all.jar with the extension itself -->
		    <plugin>
		      <groupId>org.apache.maven.plugins</groupId>
		      <artifactId>maven-assembly-plugin</artifactId>
		      <version>3.7.1</version>
		      <configuration>
			      <appendAssemblyId>false</appendAssemblyId>
				  <descriptors>
					  <descriptor>assembly-all.xml</descriptor>
				  </descriptors>
		      </configuration>
		      <executions>
		        <execution>
		          <id>make-assembly</id>
		          <phase>package</phase>
		          <goals>
		            <goal>single</goal>
		          </goals>
		        </execution>
		      </executions>
		    </plugin>
			<!-- shade required dependencies into the extension -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>true</createDependencyReducedPom>
							<dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
							<promoteTransitiveDependencies>true</promoteTransitiveDependencies>
							<createSourcesJar>true</createSourcesJar>
							<artifactSet>
								<excludes>
									<exclude>org.finos.fluxnova.commons:*</exclude>
									<exclude>org.slf4j:*</exclude>
								</excludes>
							</artifactSet>
 							<relocations>
								<relocation>
									<pattern>org.apache</pattern>
									<shadedPattern>keycloakjar.org.apache</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.springframework</pattern>
									<shadedPattern>keycloakjar.org.springframework</shadedPattern>
								</relocation>
								<relocation>
									<pattern>io.micrometer</pattern>
									<shadedPattern>keycloakjar.io.micrometer</shadedPattern>
								</relocation>
								<relocation>
								    <pattern>com.google.gson</pattern>
								    <shadedPattern>keycloakjar.com.google.gson</shadedPattern>
								</relocation>
                                <relocation>
                                    <pattern>org.checkerframework</pattern>
                                    <shadedPattern>keycloakjar.org.checkerframework</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.errorprone.annotations</pattern>
                                    <shadedPattern>keycloakjar.com.google.errorprone.annotations</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>keycloakjar.com.github.benmanes.caffeine</shadedPattern>
                                </relocation>
							</relocations>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer" />
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- make sure javadocs are generated for fluxnova-keycloak-all -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<includeDependencySources>true</includeDependencySources>
					<includeTransitiveDependencySources>true</includeTransitiveDependencySources>
					<dependencySourceIncludes>
						<include>org.finos.fluxnova.bpm.extension:fluxnova-keycloak</include>
					</dependencySourceIncludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
